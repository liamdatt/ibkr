# ibkr = read your account through the Client Portal Gateway. sample = made-up holdings for trying the app.
PORTFOLIO_SOURCE=ibkr

# Client Portal Gateway. Log in at this address in a browser first.
IBKR_GATEWAY_URL=https://localhost:5000
# Leave empty to use the first account on the login.
IBKR_ACCOUNT_ID=

# Claude, used by the Advisor page. Either one works.
ANTHROPIC_API_KEY=
# ANTHROPIC_OAUTH_TOKEN=
AI_MODEL=claude-opus-5-5

PORT=8787

# Only for running on a server. The app refuses a public HOST without a password of 16+ characters.
# Sign in with the username "desk".
# HOST=0.0.0.0
# PUBLIC_HOST=desk.example.com
# APP_PASSWORD=
